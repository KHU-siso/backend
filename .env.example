DATABASE_URL=postgresql://siso:siso@localhost:5432/siso
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db
# 콤마(,)로 구분된 프론트엔드 출처 목록. 값을 비워두면 코드 기본값(localhost:3000, localhost:5173)이 쓰인다.
# 운영 배포 시에는 실제 프론트엔드 도메인으로 반드시 교체할 것 (예: https://siso.app,https://www.siso.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# PDF 업로드 시 허용하는 최대 파일 크기 (MB 단위). 값을 비워두면 코드 기본값(20)이 쓰인다.
MAX_UPLOAD_SIZE_MB=20
# 서버 로그 레벨 (DEBUG/INFO/WARNING/ERROR). 개발 환경은 DEBUG, 운영 환경은 INFO 권장.
LOG_LEVEL=DEBUG
# 복습 알림 메일 발송 (Gmail SMTP). EMAIL_ENABLED=true이고 SMTP_USER/SMTP_PASSWORD가 채워져 있어야 발송된다.
# SMTP_PASSWORD에는 Google 계정의 "앱 비밀번호"(2단계 인증 필요)를 넣는다.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=MORAM
# 과제 마감 이메일 알림 스케줄러. 기본은 켜짐(SCHEDULER_ENABLED=true). 이 서버에서만 끄려면 false.
# 서버를 여러 대 띄워도 중복 발송은 DB(email_notification_logs)가 막는다. 메일이 실제로 나가려면 위 EMAIL_ENABLED=true 와 SMTP 설정이 필요하다.
SCHEDULER_ENABLED=true
# 몇 초마다 마감 임박 과제를 확인할지 (기본 300초). 로컬 테스트할 때는 10 정도로 줄인다.
SCHEDULER_INTERVAL_SECONDS=300
