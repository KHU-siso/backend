DATABASE_URL=postgresql://siso:siso@localhost:5432/siso
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db
# 콤마(,)로 구분된 프론트엔드 출처 목록. 값을 비워두면 코드 기본값(localhost:3000, localhost:5173)이 쓰인다.
# 운영 배포 시에는 실제 프론트엔드 도메인으로 반드시 교체할 것 (예: https://siso.app,https://www.siso.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# PDF 업로드 시 허용하는 최대 파일 크기 (MB 단위). 값을 비워두면 코드 기본값(20)이 쓰인다.
MAX_UPLOAD_SIZE_MB=20
# 서버 로그 레벨 (DEBUG/INFO/WARNING/ERROR). 개발 환경은 DEBUG, 운영 환경은 INFO 권장.
LOG_LEVEL=DEBUG
